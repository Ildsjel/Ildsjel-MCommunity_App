# ── Grimr Frontend — Environment Variables ───────────────────────────────────
# On Vercel: set these in Project Settings → Environment Variables
# Locally:   copy to .env.local

# URL of the deployed backend API (no trailing slash)
# Render example: https://grimr-api.onrender.com
NEXT_PUBLIC_API_URL=https://grimr-api.onrender.com

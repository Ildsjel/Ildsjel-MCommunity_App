# ── Grimr Backend — Environment Variables ────────────────────────────────────
# Copy to .env and fill in values. Never commit .env to git.

# App
ENVIRONMENT=production
DEBUG=false

# Neo4j Aura (cloud) — console.neo4j.io → your instance → Connect
# Format: neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-aura-instance-password

# Auth — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://your-app.vercel.app
FRONTEND_URL=https://your-app.vercel.app

# Spotify — https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://your-app.vercel.app/spotify/connect

# Last.fm — https://www.last.fm/api/account/create
LASTFM_API_KEY=
LASTFM_API_SECRET=

# Ticketmaster (events) — https://developer.ticketmaster.com
TICKETMASTER_API_KEY=

# Email (Gmail App Password — 2FA must be active on the Google account)
# https://support.google.com/accounts/answer/185833
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM_EMAIL=noreply@grimr.app

# First superadmin (email of an existing user — role is set on startup)
SUPERADMIN_EMAIL=your@email.com

# File uploads — ephemeral on Render free tier (ok for MVP)
UPLOADS_DIR=/tmp/grimr_uploads
